{
  "name": "@ludify/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-player.ts && node scripts/build-form.ts && node scripts/build-guide.ts",
    "typecheck": "npm run build && tsc --noEmit",
    "test": "npm run build && vitest run",
    "dev": "npm run build && wrangler dev --port 8791",
    "smoke": "npm run build && node scripts/smoke.ts && node scripts/player-check.ts && node scripts/form-check.ts"
  },
  "dependencies": {
    "@ludify/deck": "*",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
